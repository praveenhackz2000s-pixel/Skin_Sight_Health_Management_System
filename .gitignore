# ---- secrets and local configuration (never commit these)
db.properties
.env
.env.*
*.pem
*.key

# ---- JDBC driver (each person downloads it, see lib/README.md; run.bat / run.sh do it automatically)
lib/*.jar

# ---- compiled output
out/
build/
bin/
*.class
sources.txt

# ---- database dumps (could contain personal data)
*.dump
*.bak
backup*.sql
dump*.sql

# ---- editor / OS clutter
.idea/
*.iml
.classpath
.project
.settings/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.DS_Store
Thumbs.db
*.log
hs_err_pid*
