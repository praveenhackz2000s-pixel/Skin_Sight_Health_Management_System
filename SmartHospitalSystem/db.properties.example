# Copy this file to  db.properties  (that name is ignored by Git) and put YOUR OWN values here.
# Environment variables with the same meaning (DB_URL, DB_USER, DB_PASSWORD, PORT, APP_USER,
# APP_PASSWORD) always win over this file. Never commit db.properties.

# --- database -------------------------------------------------------------
db.url=jdbc:mysql://localhost:3306/smart_hospital?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
db.user=root
db.password=

# --- web server (optional) ------------------------------------------------
# port=8080

# --- login (optional locally, REQUIRED for any website on the internet) ----
# app.user=staff
# app.password=choose-a-long-password

# --- automatic database setup (optional) ----------------------------------
# auto.init.db=true      creates database + tables on start when missing
# load.demo.data=true    loads the fictional demo data when there are no doctors yet
